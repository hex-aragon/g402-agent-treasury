FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
COPY packages/x402-core/package.json ./packages/x402-core/package.json
COPY packages/akash/package.json ./packages/akash/package.json
COPY packages/filecoin/package.json ./packages/filecoin/package.json
COPY packages/cosmos/package.json ./packages/cosmos/package.json
RUN npm ci
COPY . .
RUN npm run build
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app ./
USER node
EXPOSE 3000
CMD ["npm","start"]
