FROM node:24-alpine AS deps
WORKDIR /app
COPY package*.json ./
COPY packages/x402-core/package.json ./packages/x402-core/package.json
COPY packages/akash/package.json ./packages/akash/package.json
COPY packages/filecoin/package.json ./packages/filecoin/package.json
COPY packages/cosmos/package.json ./packages/cosmos/package.json
RUN npm ci

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .
USER node
STOPSIGNAL SIGTERM
CMD ["node", "--import", "tsx", "worker/indexer.ts"]
