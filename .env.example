# Application and persistence
NODE_ENV=development
APP_URL=http://localhost:3000
# Production Vercel uses the dedicated Neon PostgreSQL connection string.
# Railway must instead use its private Postgres reference variable.
DATABASE_URL=
DATABASE_POOL_MAX=5
FACILITATOR_API_KEYS=
ADMIN_API_KEYS=
CRON_SECRET=
FACILITATOR_PUBLIC=true

# Shared x402 v2 settings
X402_SAMPLE_PRICE_ATOMIC=1000
X402_FACILITATOR_URL=
X402_FACILITATOR_TIMEOUT_MS=15000
X402_FACILITATOR_BEARER_TOKEN=

# EVM: Base Sepolia is the default testnet rail
X402_EVM_PAY_TO=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
X402_ALLOW_EVM_MAINNET=false
X402_ENABLE_EVM_MAINNET_SETTLEMENT=false
X402_ETHEREUM_PAY_TO=
ETHEREUM_MAINNET_RPC_URL=

# Solana: Devnet is the default SVM rail. The ordered list takes precedence.
SOLANA_DEVNET_RPC_URL=
SOLANA_DEVNET_RPC_URLS=https://api.devnet.solana.com,https://solana-devnet.api.onfinality.io/public,https://rpc.ankr.com/solana_devnet
X402_SOLANA_PAY_TO=
X402_ALLOW_SOLANA_MAINNET=false
X402_ENABLE_SOLANA_MAINNET_SETTLEMENT=false
X402_SOLANA_MAINNET_PAY_TO=
SOLANA_MAINNET_RPC_URL=

# Read-only on-chain reconciliation for known transaction hashes
X402_RECONCILE_RPC_TIMEOUT_MS=8000

# Native Gno v1 adapter
G402_MERCHANT_ADDRESS=
G402_SELF_TEST_MODE=true
G402_PAYMENT_MODE=direct
G402_CONTRACT_PATH=
G402_SAMPLE_PRICE=1000
G402_ENABLE_SETTLEMENT=false
G402_ALLOW_MAINNET=false
GNO_NETWORK_ID=gno:pearl-1
GNO_CHAIN_ID=pearl-1
GNO_RPC_URL=https://rpc.pearl.testnets.gno.land
# Explicitly public browser metadata; never place credentials in these values.
NEXT_PUBLIC_GNO_CHAIN_ID=pearl-1
NEXT_PUBLIC_GNO_RPC_URL=https://rpc.pearl.testnets.gno.land
GNO_ASSET=gno.land/r/gnoland/wugnot
GNO_DENOM=ugnot
GNO_DEPLOYER_ADDRESS=
GNO_KEY_NAME=
GNO_DEPLOY_GAS_FEE=1000000ugnot
GNO_DEPLOY_GAS_WANTED=20000000

# Gno indexer. Production Vercel uses scheduled.
# Override INDEXER_MODE=persistent for Docker Compose or Railway.
INDEXER_MODE=scheduled
INDEXER_INTERVAL_MS=4000
INDEXER_BOOTSTRAP_DEPTH=100
INDEXER_BATCH_SIZE=20
INDEXER_MAX_REORG_DEPTH=100
INDEXER_CONFIRMATIONS=2
INDEXER_TICK_MAX_MS=240000
INDEXER_LEASE_SECONDS=60
# Daily snapshot readiness allowance. Use tighter limits for a persistent worker.
INDEXER_READY_MAX_LAG=20000
INDEXER_READY_MAX_AGE_MS=90000000

# Separately gated monorepo integrations
AKASH_ENABLE_DEPLOYMENTS=false
AKASH_ALLOW_MAINNET=false
FILECOIN_ENABLE_PAY=false
FILECOIN_ALLOW_MAINNET=false
COSMOS_ENABLE_SETTLEMENT=false
COSMOS_ALLOW_MAINNET=false
